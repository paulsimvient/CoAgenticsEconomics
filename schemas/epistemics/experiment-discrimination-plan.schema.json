{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coagentics.epistemics.v1/experiment-discrimination-plan",
  "title": "CoAgentics Experiment Discrimination Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "rival_set_id", "intervention_id", "objective", "acquisition_method", "expected_outcomes", "authority_requirements", "safety_constraints", "model_validity_requirements", "stopping_rule", "provenance"],
  "properties": {
    "schema_version": {"const": "coagentics.epistemics.v1"},
    "id": {"type": "string", "minLength": 1},
    "rival_set_id": {"type": "string", "minLength": 1},
    "intervention_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "acquisition_method": {"type": "string", "minLength": 1},
    "expected_outcomes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "predicted_result"],
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1},
          "predicted_result": {"type": "string", "minLength": 1}
        }
      }
    },
    "authority_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "safety_constraints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "model_validity_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stopping_rule": {"type": "string", "minLength": 1},
    "provenance": {"type": "object"}
  }
}
