{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coagentics.epistemics.v1/hypothesis-record",
  "title": "CoAgentics Hypothesis Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "type", "statement", "mechanism", "scope_conditions", "assumptions", "predicted_signatures", "falsifiers", "rival_hypothesis_ids", "source_assertion_ids", "discovery_dataset_ids", "confirmation_dataset_ids", "permitted_intervention_ids", "evidence_links", "status", "belief_weight", "belief_method", "registered_at_utc", "provenance"],
  "properties": {
    "schema_version": {"const": "coagentics.epistemics.v1"},
    "id": {"type": "string", "minLength": 1},
    "type": {"enum": ["state", "mechanism", "intervention", "strategy", "model_validity"]},
    "statement": {"type": "string", "minLength": 1},
    "mechanism": {"type": "string", "minLength": 1},
    "scope_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "assumptions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "predicted_signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "variable", "expected_pattern", "observation_window", "falsifying_pattern"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "variable": {"type": "string", "minLength": 1},
          "expected_pattern": {"type": "string", "minLength": 1},
          "observation_window": {"type": "string", "minLength": 1},
          "falsifying_pattern": {"type": "string", "minLength": 1}
        }
      }
    },
    "falsifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rival_hypothesis_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source_assertion_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "discovery_dataset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "confirmation_dataset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "permitted_intervention_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "direction", "rationale", "discovery_only"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "direction": {"enum": ["supports", "contradicts", "neutral", "context_only"]},
          "rationale": {"type": "string", "minLength": 1},
          "discovery_only": {"type": "boolean"}
        }
      }
    },
    "status": {"enum": ["proposed", "active", "weakened", "supported", "not_supported", "inconclusive", "superseded", "retired"]},
    "belief_weight": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "belief_method": {"type": "string"},
    "registered_at_utc": {"type": "string", "format": "date-time"},
    "provenance": {"type": "object"}
  }
}
