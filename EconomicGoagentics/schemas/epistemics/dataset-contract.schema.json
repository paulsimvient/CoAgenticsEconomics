{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coagentics.epistemics.v1/dataset-contract",
  "title": "CoAgentics Dataset Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "role", "channel", "version", "content_sha256", "sealed", "contains_actions", "contains_outcomes", "permitted_uses", "prohibited_uses", "feedback_policy", "provenance"],
  "properties": {
    "schema_version": {"const": "coagentics.epistemics.v1"},
    "id": {"type": "string", "minLength": 1},
    "role": {"enum": ["discovery", "calibration", "development", "sealed_validation", "prospective"]},
    "channel": {"enum": ["literature", "historical_observation", "historical_decision", "current_sensor", "simulation", "human"]},
    "version": {"type": "string", "minLength": 1},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sealed": {"type": "boolean"},
    "contains_actions": {"type": "boolean"},
    "contains_outcomes": {"type": "boolean"},
    "permitted_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prohibited_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "feedback_policy": {"type": "string", "minLength": 1},
    "provenance": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "sealed_validation"}}},
      "then": {"properties": {"sealed": {"const": true}}}
    }
  ]
}
